<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Windows-only helper that OIBus's south-opc connector spawns as a local child process (see
    backend/src/south/south-opc/south-opc.ts) and talks to over a newline-delimited JSON protocol
    on stdin/stdout. It replaces the OPC module of OIBusAgentWindows: same Quick.OpcNetApi/OpcComRcw
    DCOM interop (OPC Classic DA + HDA), but bundled and launched by OIBus itself instead of being
    installed and administered as a separate Windows Service reachable over a configured agentUrl.

    Confirmed working on net9.0-windows via live testing against a real Matrikon OPC Simulation
    server (both DA and HDA modes, plus browse) — no OIBusAgentWindows-style net48 requirement here
    (contrast with @oibus/pi-afsdk-windows, which does need net48 for the AF SDK).

    Published as a self-contained single-file executable per architecture, e.g. for win-x64:
      dotnet publish -c Release -r win-x64 -p:SelfContained=true -p:PublishSingleFile=true
    (repeat with -r win-x86 and -r win-arm64). The resulting binary is what gets bundled as a pkg
    asset for the OIBus Windows build (see backend/package.json's pkg.assets).
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>OIBusOpcClassicWindows</AssemblyName>
    <RootNamespace>OIBusOpcClassicWindows</RootNamespace>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!-- Same versions as OIBusAgentWindows.csproj's packages.config, for behavioral parity. -->
    <PackageReference Include="Quick.OpcComRcw" Version="2.1.108" />
    <PackageReference Include="Quick.OpcNetApi" Version="2.1.108" />
    <PackageReference Include="Quick.OpcNetApi.Com" Version="2.1.108" />
  </ItemGroup>

</Project>
